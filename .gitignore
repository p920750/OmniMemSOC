# ==============================================================================
# OmniMemSOC .gitignore (Secure Root Configuration)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Sensitive Credentials
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
credentials.json
secrets.json
auth.json

# ------------------------------------------------------------------------------
# 2. Python & Backend Build Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
!frontend/lib/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
*.sqlite3

# ------------------------------------------------------------------------------
# 3. Node & Next.js Frontend Build Artifacts
# ------------------------------------------------------------------------------
node_modules/
.next/
out/
.npm
*.tsbuildinfo
next-env.d.ts.bak

# ------------------------------------------------------------------------------
# 4. Logs, Runtime Dumps & Temporary Files
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# 5. OS & IDE Specific Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDEs
.idea/
.vscode/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# Large Media & Video Files
*.mp4
*.mov
*.avi
demovideo/
